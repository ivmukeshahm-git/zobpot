@push('script')
    <script>
        $(document).ready(function() {
            var datatable = $('#PricingDataTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: "{{ route('admin.pricing.gettabledata') }}",
                    type: "POST",
                    data: function(d) {
                        d._token = '{{ csrf_token() }}'; // Required for POST in Laravel
                    }
                },
                columns: [{
                        data: 'DT_RowIndex',
                        name: 'DT_RowIndex',
                        orderable: false,
                        searchable: false
                    },
                    {
                        data: 'plan_name',
                        name: 'plan_name'
                    },
                    {
                        data: 'price_duration',
                        name: 'price_duration'
                    },
                    {
                        data: 'plan_for',
                        name: 'plan_for'
                    },
                    {
                        data: 'status',
                        name: 'status'
                    },

                    {
                        data: 'action',
                        name: 'action',
                        orderable: false,
                        searchable: false
                    }

                ]
            });

            $('#PricingDataTable tbody').on('click', '.view-details-btn', function() {
                var $row = $(this).closest('tr');
                var rowData = datatable.row($row).data();

                // Open modal
                $("#JobPricing").modal("show");


                // Fill form fields
                $("#plan_name").val(rowData.plan_name);
                $("#plan_price").val(rowData.plan_price);
                $("#duration_time").val(rowData.plan_time);
                $("#plan_description").val(rowData.plan_description);
                $("#plan_for").val(rowData.plan_for_type.trim()).trigger('change');
                $("#plan_duration").val(rowData.plan_duration).trigger('change');
                $("#plan_service").val((rowData.service || 'none').toString().trim()).trigger('change');

                // Reset benefits box, then load only non-empty benefits
                var benefitsHtml = `
                <div class="row mb-4 benefit-row">
                    <div class="col-lg-11">
                        <input type="text" class="form-control" name="plan_benefits[]"
                            placeholder="Enter Benefits" style="background-color: #fff;">
                    </div>
                    <div class="col-lg-1">
                        <button type="button" class="btn btn-sm btn-primary p-2 add-benefit">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>`;
                $("#benifitsBoxHtml").html(benefitsHtml);

                var benefits = rowData.benefits ? rowData.benefits.split(',') : [];
                benefits.forEach(function(benefit) {
                    var text = (benefit || '').toString().trim();
                    if (!text || text.toLowerCase() === 'null') {
                        return;
                    }
                    var safeText = $('<div>').text(text).html();
                    var newBenefitRow = `
        <div class="row mb-4 benefit-row">
            <div class="col-lg-11">
                <input type="text" class="form-control" name="plan_benefits[]" value="${safeText}" placeholder="Enter Benefits" style="background-color: #fff;">
            </div>
            <div class="col-lg-1">
                <button type="button" class="btn btn-sm btn-danger p-2 remove-benefit">
                    <i class="fa fa-trash"></i>
                </button>
            </div>
        </div>`;
                    $("#benifitsBoxHtml").append(newBenefitRow);
                });

                // Set form state
                $("#JobPricingTitle").text("Edit Plan & Pricing");


                $("#flag").val("U");
                $("#row_id").val(rowData.plan_id);
                $("#_method").val("PUT");
            });


            $('#PricingDataTable tbody').on('click', '.delete-plan-btn',
                function() { // Delegated event handler for the button
                    var $row = $(this).closest('tr'); // Get the closest row element
                    var rowData = datatable.row($row).data(); // Get the entire row data object


                    Swal.fire({
                        title: 'Are you sure?',
                        text: "Are you sure to delete Pricing?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, confirm!',
                        customClass: {
                            confirmButton: 'btn btn-primary me-3',
                            cancelButton: 'btn btn-label-secondary'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {

                            var PlanId = rowData.plan_id;
                            var data = {
                                'PlanId': PlanId
                            }

                            $.ajaxSetup({
                                headers: {
                                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                                }
                            });

                            LoaderShow()

                            $.ajax({
                                type: "DELETE",
                                url: "{{ url('admin/pricing') }}/" + PlanId,
                                data: data,
                                dataType: "json",
                                success: function(response) {
                                    LoaderHide()
                                    if (response.status === 1) {
                                        toastr.success(response.message, 'Success');


                                        location.reload();
                                    } else {
                                        toastr.warning(response.message, 'Warning');
                                    }
                                }
                            });
                            return false;
                        }
                    });
                });




            $('#JobPricing').on('hidden.bs.modal', function() {
                $("#_method").val("POST");
                $("#flag").val("A");
                $("#row_id").val("");
                $("#JobPricingTitle").text("Plan & Pricing");
                $("#plan_service").val("none");
                $("#benifitsBoxHtml").html(`
                <div class="row mb-4 benefit-row">
                    <div class="col-lg-11">
                        <input type="text" class="form-control" name="plan_benefits[]"
                            placeholder="Enter Benefits" style="background-color: #fff;">
                    </div>
                    <div class="col-lg-1">
                        <button type="button" class="btn btn-sm btn-primary p-2 add-benefit">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>`);
            });


        });


        let validator = $("#pricing-form").validate({
            rules: {
                plan_name: {
                    required: true
                },
                plan_price: {
                    required: true
                },
                plan_duration: {
                    required: true
                },
                duration_time: {
                    required: true
                },
                plan_description: {
                    required: true
                },
                plan_for: {
                    required: true
                },
                service: {
                    required: true
                },

            },
            messages: {
                plan_name: {
                    required: "Please Enter Plan Name"
                },
                plan_price: {
                    required: "Please Enter Plan Price"
                },
                plan_duration: {
                    required: "Please Enter Plan Duration"
                },
                duration_time: {
                    required: "Please Enter Duration Time"
                },
                plan_description: {
                    required: "Please Enter Plan Description"
                },
                plan_for: {
                    required: "Please Select Plan For"
                },
                service: {
                    required: "Please Select Service"
                },
            },
            errorElement: "div",
            errorPlacement: function(error, element) {
                error.addClass("invalid-feedback");
                error.insertAfter(element);
            },
            highlight: function(element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function(element) {
                $(element).removeClass("is-invalid");
            }
        });

        // ✅ Final submission with AJAX
        $("#pricing-form").submit(function(e) {
            e.preventDefault();

            if (!$("#pricing-form").valid()) {
                return;
            }

            let form = $(this);
            // let url = form.attr('action');
            let formData = form.serialize(); // Use FormData for file uploads

            $.ajaxSetup({
                headers: {
                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                }
            });


            var flag = $("#flag").val();
            var id = $("#row_id").val();

            var url = "";
            if (flag == "A") {
                url = "{{ route('admin.pricing.store') }}";
            } else {
                url = "{{ url('admin/pricing') }}/" + id;
            }

            LoaderShow()

            $.ajax({
                type: "POST",
                url: url,
                data: formData,
                success: function(response) {
                    LoaderHide()
                    if (response.status === 1) {
                        toastr.success(response.message, 'Success');
                        form[0].reset();
                        validator.resetForm();

                        location.reload();
                    } else {
                        toastr.warning(response.message, 'Warning');
                    }
                },
                error: function(xhr) {
                    LoaderHide()
                    console.log(xhr.responseText);
                    toastr.error(response.message, 'Error');
                }
            });
        });

        document.addEventListener("DOMContentLoaded", function() {
            const benefitsBox = document.querySelector(".plan-benifits-box");

            benefitsBox.addEventListener("click", function(e) {
                if (e.target.closest(".add-benefit")) {
                    const newBenefitRow = document.createElement("div");
                    newBenefitRow.classList.add("row", "mb-4", "benefit-row");
                    newBenefitRow.innerHTML = `
                    <div class="col-lg-11">
                        <input type="text" class="form-control" name="plan_benefits[]" id="plan_benefits" placeholder="Enter Benefits" style="background-color: #fff;">
                    </div>
                    <div class="col-lg-1">
                        <button type="button" class="btn btn-sm btn-danger p-2 remove-benefit">
                            <i class="fa fa-trash"></i>
                        </button>
                    </div>
                `;
                    benefitsBox.appendChild(newBenefitRow);
                }

                if (e.target.closest(".remove-benefit")) {
                    e.target.closest(".benefit-row").remove();
                }
            });
        });
    </script>
@endpush
