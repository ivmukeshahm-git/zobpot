    <style>
        /* ============================================
   JOB CARD — FINAL FIXED HEIGHT + CLEAN SPACING
   ============================================ */

        .job-card-simple {
            background: #F8FAFF;
            border-radius: 16px;
            padding: 14px !important;
            margin: 14px 0 !important;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
            border: 1px solid #242a65;
            transition: 0.3s ease;
            cursor: pointer;

            /* Auto height with equal row stretch */
            height: 100%;
            min-height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            position: relative;
        }

        .job-card-simple:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(36, 42, 101, 0.12);
            border-color: #242a65;
        }

        /* Badge - Work Type */
        .job-badge {
            background: #f36825;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
            position: absolute;
            top: 10px;
            left: 14px;
            box-shadow: 0 2px 6px rgba(243, 104, 37, 0.25);
        }

        /* Main Content Block */
        .job-main {
            padding-top: 38px; /* space below badge */
            flex: 1 1 auto;
        }

        .job-title {
            font-size: 18px;
            font-weight: 700;
            color: #242a65;
            margin-bottom: 6px;
            line-height: 1.4;

            /* Allow only 2 lines */
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Status Badge */
        .badge {
            font-size: 11px;
            padding: 5px 12px;
        }

        /* Location */
        .location {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-top: 6px;
            color: #444;
        }

        .location span {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            word-break: break-word;
        }

        .location i {
            color: #f36825;
        }

        /* Job Details Box */
        .job-details {
            background: #f0f3ff;
            padding: 12px;
            border-radius: 12px;
            margin-top: auto;
            font-size: 14px;
        }

        .detail {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #555;
        }

        .detail i {
            color: #242a65;
        }

        /* Apply History Button */
        .view-btn {
            background: #242a65;
            color: white !important;
            border: none;
            padding: 10px 16px;
            border-radius: 8px;
            font-weight: 600;
            text-align: center;
            width: 100%;
            margin-top: 10px;
            transition: 0.25s ease;
        }

        .view-btn:hover {
            background: #f36825;
            transform: translateY(-2px);
        }

        /* Responsive: Mobile Adjust */
        .display-list > [class*="col-"] {
            display: flex;
        }

    </style>
@endpush

